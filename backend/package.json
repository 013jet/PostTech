{
  "name": "posttech-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev:local": "tsx src/local.ts",
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/seed.ts",
    "build": "tsc",
    "build:vercel": "tsc && esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=cloud/index.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^10.3.0",
    "@vercel/functions": "3.10.1",
    "fastify": "^5.12.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.0",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2"
  }
}
